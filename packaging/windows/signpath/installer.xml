<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration 'installer': signs the installer,
     paperman-setup-VERSION.exe or paperman-setup-VERSION-arm64.exe,
     uploaded by the release workflow as a GitHub artifact, which is a ZIP
     archive. The program inside it is signed before it is built -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" default-value="0.0.0.0" />
  </parameters>
  <zip-file>
    <pe-file path="paperman-setup-*.exe" product-name="Paperman"
             product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
